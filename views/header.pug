//- Header
header.header 
    nav.nav.nav--tours 
        a.nav__el(href="#") All Tours 
        form.nav_search(action="GET") 
            button.nav__search-btn
                svg
                    use(xlink:href="imgs/icons.svg#icon-search")
            input(type="text" placeholder="Search")
    .header__logo 
        img(src="imgs/logo-white.png", alt="Natours logo")
    nav.nav.nav--user 
        a.nav__el(href="#") My Bookings
            img.nav__user-img(src="imgs/users/user-1.jpg", alt="user photo")
            span JONAS
    button.nav__el Login 
    button.nav__el.nav__el--cta Signup 