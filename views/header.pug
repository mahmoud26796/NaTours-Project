header.header
    nav.nav.nav--tours
        a.nav__el(href='/') All tours
        form.nav__search
            button.nav__search-btn
                svg
                    use(xlink:href='/imgs/icons.svg#icon-search')
            input.nav__search-input(type='text' placeholder='Search tours')
    .header__logo
        img(src='/imgs/logo-white.png' alt='Natours logo')
    nav.nav.nav--user
        if user
            a.nav__el.nav__el--logout Log out
            a.nav__el(href='/me')
                if user.photo
                    img.nav__user-img(src=`../imgs/users/${user.photo}` alt=`Photo of ${user.name}`)
                else 
                    img.nav__user-img(src=`../imgs/users/default.jpg` alt=`Photo of ${user.name}`)

                span(style="color: white; font-size: 16px;")=user.name.split(' ')[0].toUpperCase()
        else
            a.nav__el(href='/login') Log in
            a.nav__el.nav__el(href='#') Sign up